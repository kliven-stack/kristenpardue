# Growthmap lead endpoint. Public by design — it is read in the browser.
# Both forms (the /contact-us/ contact form and the /pay-my-bill/ billing form)
# POST FormData straight to it. Until it is set, the pages keep the originals
# WordPress served rather than shipping a form that posts nowhere.
PUBLIC_CONTACT_ENDPOINT=

# Canonical origin. Set automatically per environment; override for a preview
# deployment that should describe itself rather than production.
PUBLIC_SITE_URL=https://kristenpardue.com

# growthmap (default) = our static forms. embed = the original LeadConnector
# iframe and WPForms markup, for A/B comparison against production only.
PUBLIC_FORM_MODE=growthmap

# on (default) = link Elementor's self-hosted Poppins and Lexend Deca sheets,
# which is what production renders. off = system stack.
PUBLIC_WEBFONTS=on

# on (default) = the client's GoHighLevel chat bubble, as WordPress prints it.
PUBLIC_CHAT_WIDGET=on

# on (default) = the client's Google tags (GTM, two GA4 properties, one Ads tag).
# The verification harness sets this off so Google's scripts cannot move numbers
# underneath a measurement run.
PUBLIC_ANALYTICS=on

# on = build with the corrections in src/lib/fixes.ts applied. The default build
# is a faithful clone, bugs included — see the README's bug register.
PUBLIC_APPLY_FIXES=
