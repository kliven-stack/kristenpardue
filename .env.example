# Canonical origin. Set automatically per environment; override for a preview
# deployment that should describe itself rather than production.
PUBLIC_SITE_URL=https://kristenpardue.com

# on (default) = link the five self-hosted Google families (Montserrat, Oswald,
# Poiret One, Raleway, Sacramento). off = system stack.
PUBLIC_WEBFONTS=on

# Inert here — this install carries no chat widget. Kept so that adding one to
# WordPress is a re-extract rather than a code change.
PUBLIC_CHAT_WIDGET=on

# Inert here too — this site carries no analytics tag of any kind. The
# verification harness sets it off so a future tag could never move numbers
# underneath a measurement run.
PUBLIC_ANALYTICS=on

# on = build with the corrections in src/lib/fixes.ts applied. The default build
# is a faithful clone, bugs included — see the README's bug register.
PUBLIC_APPLY_FIXES=
