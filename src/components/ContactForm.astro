---
/**
 * Growthmap lead forms (playbook §4b).
 *
 * Fully static: the browser POSTs FormData straight to `PUBLIC_CONTACT_ENDPOINT`,
 * so the site needs no adapter and no serverless function. These replace the two
 * third-party embeds the WordPress site carries:
 *
 *   contact    /contact-me/ — ActiveCampaign form 5, injected into the page by a
 *              loader from kristenpardue16396.activehosted.com. Nothing about it is
 *              in the served HTML.
 *   subscribe  Elementor popup 2995, shown one second after load on every page — a
 *              LeadConnector ("Trustymail") iframe, form FMxAdmW9fwWIvqjnE8bk,
 *              "Subscribe - BSC".
 *
 * Both field sets were read off the originals rather than guessed, with
 * `npm run form:inspect`, which drives the live pages in headless Chrome and reads
 * each widget's own document:
 *
 *   contact    First Name / Last Name / Email* / Phone, a three-option "I have a
 *              question about…" select, and a Message box. 39px rows on white,
 *              1px #979797 at 4px radius with 8px padding, IBM Plex Sans 14px, over
 *              a #FFC1B8 Submit at 4px radius.
 *   subscribe  Full Name / Email* / Phone. 55px rows, transparent on a 2px #FFC1B8
 *              border at 0 radius with 15px/20px padding, Roboto 14px, over a 51px
 *              #FFC1B8 Submit, white, 0 radius, Roboto 17px/600.
 *
 * Deliberate departures, all accessibility or correctness fixes:
 *   * the subscribe widget labels by placeholder only, which is not an accessible
 *     name, so its labels are real `<label>`s kept out of the picture;
 *   * the field each widget marks with an asterisk is actually `required` (both
 *     render the asterisk and set `required` on nothing but the email);
 *   * the phone fields are plain `tel` inputs rather than the widgets' country
 *     pickers, which are JS components we are not shipping;
 *   * neither replacement carries the ActiveCampaign form's reCAPTCHA — that is
 *     Growthmap's side of the endpoint to manage (playbook §4b), not the page's.
 */
import { CONTACT_ENDPOINT } from '../config';

interface Props {
  variant: 'contact' | 'subscribe';
  /** Names the region, so ids stay unique if a form ever renders twice on a page. */
  region: string;
}

const { variant, region } = Astro.props as Props;

interface Field {
  name: string;
  tag: 'input' | 'textarea' | 'select';
  type?: 'text' | 'email' | 'tel';
  label: string;
  placeholder?: string;
  autocomplete?: string;
  required?: boolean;
  /** Renders two inputs side by side (the contact form's name row). */
  half?: boolean;
  options?: string[];
}

const CONTACT_FIELDS: Field[] = [
  { name: 'firstname', tag: 'input', type: 'text', label: 'First Name', placeholder: 'Type your first name', autocomplete: 'given-name', half: true },
  { name: 'lastname', tag: 'input', type: 'text', label: 'Last Name', placeholder: 'Type your last name', autocomplete: 'family-name', half: true },
  { name: 'email', tag: 'input', type: 'email', label: 'Email', placeholder: 'Type your email', autocomplete: 'email', required: true },
  { name: 'phone', tag: 'input', type: 'tel', label: 'Phone', placeholder: 'Type your phone number', autocomplete: 'tel' },
  {
    name: 'enquiry', tag: 'select', label: 'I have a question about...',
    // Verbatim from the live widget, leading blank option included.
    options: ['', 'Signing up for Essential oils', 'Health or Business Consultation', 'Speaking inquiry'],
  },
  { name: 'message', tag: 'textarea', label: 'Message', placeholder: 'Questions or comments?' },
];

const SUBSCRIBE_FIELDS: Field[] = [
  { name: 'full_name', tag: 'input', type: 'text', label: 'Full Name', placeholder: 'Full Name', autocomplete: 'name' },
  { name: 'email', tag: 'input', type: 'email', label: 'Email', placeholder: 'Email', autocomplete: 'email', required: true },
  { name: 'phone', tag: 'input', type: 'tel', label: 'Phone', placeholder: 'Phone', autocomplete: 'tel' },
];

const FIELDS = variant === 'contact' ? CONTACT_FIELDS : SUBSCRIBE_FIELDS;
const FORM_NAME = variant === 'contact' ? 'Contact Me' : 'Subscribe - BSC';

const id = (name: string) => `gm-${region}-${variant}-${name}`;
---

<div class:list={['gm-form', `gm-form--${variant}`]}>
  <form
    class="gm-form__form"
    method="post"
    action={CONTACT_ENDPOINT}
    data-endpoint={CONTACT_ENDPOINT}
    data-variant={variant}
  >
    <input type="hidden" name="form_name" value={FORM_NAME} />
    <input type="hidden" name="source_page" value="" data-fill="path" />

    <div class="gm-form__rows">
      {FIELDS.map((field) => (
        <div class:list={[
          'gm-form__field',
          field.half && 'gm-form__field--half',
          field.tag === 'textarea' && 'gm-form__field--area',
        ]}>
          <label class:list={['gm-form__label', variant === 'subscribe' && 'gm-form__label--hidden']} for={id(field.name)}>
            {field.label}{field.required && <span class="gm-form__req" aria-hidden="true">*</span>}
          </label>
          {field.tag === 'textarea' ? (
            <textarea
              id={id(field.name)}
              name={field.name}
              placeholder={field.placeholder}
              required={field.required}
            />
          ) : field.tag === 'select' ? (
            <select id={id(field.name)} name={field.name} required={field.required}>
              {field.options?.map((option) => <option value={option}>{option}</option>)}
            </select>
          ) : (
            <input
              id={id(field.name)}
              name={field.name}
              type={field.type}
              placeholder={field.placeholder}
              autocomplete={field.autocomplete}
              required={field.required}
            />
          )}
        </div>
      ))}
    </div>

    {/* Honeypot — hidden from people, irresistible to bots. */}
    <div class="gm-form__hp" aria-hidden="true">
      <label>
        Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="gm-form__submit-row">
      <button type="submit" class="gm-form__submit">Submit</button>
    </div>

    <p class="gm-form__status" role="status" aria-live="polite"></p>
  </form>
</div>

<style>
  .gm-form {
    width: 100%;
    box-sizing: border-box;
  }

  .gm-form__form { box-sizing: border-box; }

  .gm-form__rows {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
  }

  .gm-form__field {
    flex: 1 1 100%;
    min-width: 0;
    margin-bottom: 16px;
  }

  .gm-form__field--half { flex: 1 1 calc(50% - 8px); }

  @media (max-width: 767px) {
    .gm-form__field--half { flex: 1 1 100%; }
  }

  .gm-form__label {
    display: block;
    margin-bottom: 6px;
    font-family: 'IBM Plex Sans', Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #333;
  }

  .gm-form__req { color: #d93025; }

  /* The LeadConnector widget shows no labels at all — placeholders only — so the
     subscribe form's stay in the accessibility tree and out of the picture. */
  .gm-form__label--hidden,
  .gm-form__hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .gm-form__form input[type='text'],
  .gm-form__form input[type='email'],
  .gm-form__form input[type='tel'],
  .gm-form__form select,
  .gm-form__form textarea {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 8px;
    font-family: 'IBM Plex Sans', Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #333;
    background: #fff;
    border: 1px solid #979797;
    border-radius: 4px;
  }

  /* The widget's one un-rounded control, and its own darker border. */
  .gm-form__form select {
    padding: 8px 16px;
    border-color: #666;
    border-radius: 0;
  }

  .gm-form__form textarea {
    height: 60px;
    resize: vertical;
  }

  /* The LeadConnector subscribe widget is drawn quite differently: taller rows,
     transparent fill, a 2px blush border and square corners. */
  .gm-form--subscribe .gm-form__form input {
    min-height: 55px;
    padding: 15px 20px;
    font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background: transparent;
    border: 2px solid #ffc1b8;
    border-radius: 0;
  }

  .gm-form__form input::placeholder,
  .gm-form__form textarea::placeholder {
    color: #8c8f94;
    opacity: 1;
  }

  .gm-form__form input:focus-visible,
  .gm-form__form select:focus-visible,
  .gm-form__form textarea:focus-visible {
    outline: 2px solid #f1ada2;
    outline-offset: 1px;
  }

  /* `:user-invalid` rather than `:invalid`: an untouched required field is invalid
     from the first paint, and must not be painted as an error. */
  .gm-form__form input:user-invalid,
  .gm-form__form textarea:user-invalid {
    border-color: #d93025;
  }

  .gm-form__submit-row { margin-top: 15px; }

  /* `:focus` is pinned to the resting look on purpose: the Hello theme styles every
     bare `button:hover`/`:focus` with its own accent colour, which would repaint the
     widget's blush. `:focus-visible` still shows. */
  .gm-form__submit,
  .gm-form__submit:hover,
  .gm-form__submit:focus {
    display: inline-block;
    min-height: 41px;
    padding: 10px 22px;
    font-family: 'IBM Plex Sans', Helvetica, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #fff;
    text-align: center;
    background: #ffc1b8;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
  }

  .gm-form--subscribe .gm-form__submit,
  .gm-form--subscribe .gm-form__submit:hover,
  .gm-form--subscribe .gm-form__submit:focus {
    display: block;
    width: 100%;
    min-height: 51px;
    font-family: Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 17px;
    font-weight: 600;
    border-radius: 0;
  }

  .gm-form__submit:hover { background: #f1ada2; }
  .gm-form__submit:focus-visible { outline: 2px solid #333; outline-offset: 2px; }
  .gm-form__submit[disabled] { opacity: 0.6; cursor: progress; }

  .gm-form__status {
    margin: 12px 0 0;
    min-height: 1.4em;
    font-family: 'IBM Plex Sans', Helvetica, sans-serif;
    font-size: 14px;
    color: inherit;
  }

  .gm-form__status[data-state='error'] { color: #d93025; }
  .gm-form__status[data-state='ok'] { color: #2f7d4f; }
</style>

<script>
  /**
   * Delegated and registered exactly once. Astro inlines a component's script per
   * instance, so without the guard two handlers would race on one submit on any
   * page carrying both forms — which, since the subscribe popup is attached to
   * every page, means /contact-me/. The first reports success and resets the form,
   * the second then clears that message and re-validates the now-empty fields.
   */
  const w = window as unknown as { __gmFormBound?: boolean };
  if (!w.__gmFormBound) {
    w.__gmFormBound = true;

    document.addEventListener('submit', async (event) => {
      const form = (event.target as HTMLElement).closest<HTMLFormElement>('form.gm-form__form');
      if (!form) return;
      event.preventDefault();

      const status = form.querySelector<HTMLParagraphElement>('.gm-form__status')!;
      const submit = form.querySelector<HTMLButtonElement>('.gm-form__submit')!;
      const endpoint = form.dataset.endpoint || '';

      const say = (message: string, state: 'ok' | 'error' | '') => {
        status.textContent = message;
        if (state) status.dataset.state = state;
        else delete status.dataset.state;
      };

      say('', '');
      if (!form.reportValidity()) return;

      form.querySelector<HTMLInputElement>('[data-fill="path"]')!.value = location.pathname;

      // A filled honeypot is a bot: show success, send nothing.
      const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]')!;
      if (honeypot.value.trim()) {
        form.reset();
        say('Thanks — we will be in touch shortly.', 'ok');
        return;
      }

      if (!endpoint) {
        say('This form is not connected yet. Please email us instead.', 'error');
        return;
      }

      submit.disabled = true;
      const original = submit.textContent;
      submit.textContent = 'Sending…';

      try {
        const response = await fetch(endpoint, { method: 'POST', body: new FormData(form) });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        form.reset();
        form.dispatchEvent(new Event('gm:reset'));
        say('Thanks — we will be in touch shortly.', 'ok');
      } catch {
        say('Sorry, something went wrong. Please try again or email us.', 'error');
      } finally {
        submit.disabled = false;
        submit.textContent = original;
      }
    });
  }
</script>
