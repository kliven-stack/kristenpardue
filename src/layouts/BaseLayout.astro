---
/**
 * Page shell for the cloned WordPress pages.
 *
 * The <head> reproduces the original's stylesheet cascade exactly: every handle the
 * WordPress page linked, in the same order, served from public/wp/css/. Elementor's
 * compiled per-post CSS is what makes the clone pixel-accurate, so it ships verbatim
 * rather than being re-derived (playbook §2).
 */
import type { PageRecord } from '../lib/pages';
import { fragment, chatWidgetHtml, analyticsHead, analyticsBody } from '../lib/pages';
import { CHAT_WIDGET, ANALYTICS, WEBFONTS } from '../config';
import { FIXES_ON, FIX_CSS, fixPageMeta, fixSeoHead } from '../lib/fixes';
import '../styles/global.css';

interface Props {
  page: PageRecord;
}

const { page } = Astro.props as Props;
const site = Astro.site ?? new URL('https://kristenpardue.com');
const canonical = new URL(page.path, site).href;

// Yoast's block is stored with the origin templated out, so a preview deployment
// describes itself rather than production. The escaped spelling is the one inside
// the JSON-LD graph.
const seoHead = fixSeoHead(
  page.seoHead
    .split('__ORIGIN_ESC__').join(site.origin.replace(/\//g, '\\/'))
    .split('__ORIGIN__').join(site.origin),
);

const meta = fixPageMeta(page.path);
const description = meta.description ?? page.description;
const robots = meta.robots ?? page.robots;

/**
 * The five Google families, self-hosted by scripts/build-fonts.mjs. On by default,
 * because that is what production renders — it just fetches them from Google.
 */
const webfonts = WEBFONTS !== 'off';
const css = webfonts ? page.css : page.css.filter((c) => !c.name.startsWith('elementor-gf-'));

/**
 * The two faces above the fold on every page: kit 2886 sets Montserrat for headings
 * and buttons and Raleway 300 for body copy, so both latin uprights are wanted
 * immediately. Google now ships both as variable fonts, one file per subset, so
 * this is two requests rather than one per weight. Preloading them removes the swap
 * flash — which production has and the clone does not need to reproduce, because
 * production's is a symptom of the third-party round trip we removed.
 */
const PRELOAD_FONTS = webfonts
  ? [
      '/wp/fonts/JTUSjIg1_i6t8kCHKm459WlhyyTh89Y.woff2',
      '/wp/fonts/1Ptug8zYS_SKggPNyC0IT4ttDfA.woff2',
    ]
  : [];
---

<!doctype html>
<html lang={page.lang}>
  <head>
    <meta charset="UTF-8" />
    {/* Carried per page: /links/ is built on Elementor's canvas template, whose
        head prints a different viewport from the theme's. */}
    <meta name="viewport" content={page.viewport} />
    <link rel="profile" href="https://gmpg.org/xfn/11" />
    {robots && <meta name="robots" content={robots} />}
    <title set:html={page.title} />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <Fragment set:html={seoHead} />

    {/* Inert on this site — there is no tag of any kind on it. Kept so that adding
        one is a re-extract rather than a code change; see src/config.ts. */}
    {ANALYTICS && analyticsHead && <Fragment set:html={analyticsHead} />}

    {PRELOAD_FONTS.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}

    {css.map((sheet) => <link rel="stylesheet" href={`/wp/css/${sheet.name}.css`} />)}

    {page.favicons.map((icon) => (
      <link rel={icon.rel} href={icon.href} {...(icon.sizes ? { sizes: icon.sizes } : {})} />
    ))}
    {page.tile && <meta name="msapplication-TileImage" content={page.tile} />}

    {FIXES_ON && FIX_CSS && <style set:html={FIX_CSS} />}

    <slot name="head" />
  </head>

  <body class={page.bodyClass}>
    {ANALYTICS && analyticsBody && <Fragment set:html={analyticsBody} />}

    {page.hasSkipLink && (
      <a class="skip-link screen-reader-text" href="#content">Skip to content</a>
    )}

    {CHAT_WIDGET && chatWidgetHtml && <Fragment set:html={chatWidgetHtml} />}

    {page.header && <Fragment set:html={fragment(page.header)} />}

    <slot>
      <Fragment set:html={fragment(page.content)} />
    </slot>

    {page.footer && <Fragment set:html={fragment(page.footer)} />}

    {/* Popup templates.
        Elementor keeps a popup out of the document until something opens it —
        scripts/inspect-live.mjs finds zero `[data-elementor-type="popup"]` nodes in
        the live pre-open DOM of every page probed — so they are parked in
        <template> elements, whose content is not in the DOM tree at all.
        src/scripts/elementor.js clones one in, and builds the dialog wrapper around
        it, when its trigger fires: popup 2995 one second after load (at most once
        per visitor), popup 2974 from the `#elementor-action:…` link on
        /favorite-products/, and popup 3170 never, because nothing on the site
        triggers it. */}
    {page.popups.map((name) => (
      <template class="gm-popup">
        <Fragment set:html={fragment(name)} />
      </template>
    ))}

    <script src="../scripts/elementor.js"></script>
  </body>
</html>
