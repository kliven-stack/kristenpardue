# build output
dist/
.astro/
.vercel/

# dependencies
node_modules/

# environment
.env
.env.production

# system
.DS_Store
*.log

# crawl cache — regenerate with `npm run crawl`
_extract/html/
_extract/live-dom/

# measurement output — regenerate with `npm run compare`
_extract/compare-*.json
_extract/dump-*.json
_extract/spot-*.json


# `_extract/probe/` IS tracked: those scripts are the evidence behind every DOM
# contract src/scripts/elementor.js reproduces, and the comments there point at
# them by name. They read the live site, so they need no local state.
_extract/probe/*.json

# `_extract/crawl-manifest.json` and `_extract/assets.json` ARE tracked: they
# record what the crawl found and what the mirror pulled, which is the provenance
# of everything in src/fragments/ and public/wp-content/.
